{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Artha Build Preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"web"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Lint Check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Build Web Preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"web"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}